# --- Sarvam AI (speech + language) ---
# Get a key from https://dashboard.sarvam.ai/
SARVAM_API_KEY="your_sarvam_api_key_here"

# --- LiveKit (WebRTC transport) ---
# Local dev server (no account needed):  livekit-server --dev
#   URL=ws://localhost:7880  KEY=devkey  SECRET=secret
# LiveKit Cloud: https://cloud.livekit.io/ -> Settings -> Keys (use wss://)
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# --- Application ---
HOST="0.0.0.0"
PORT=8080
ENVIRONMENT="development"
DEFAULT_LANGUAGE="en-IN"

# --- Interruption / VAD sensitivity ---
# If the agent does not stop when you start speaking, LOWER these two.
# If it interrupts itself on background noise, RAISE them.
VAD_MIN_VOLUME=0.3        # 0.0-1.0  volume gate. Biggest lever. Silero default 0.6
VAD_CONFIDENCE=0.6        # 0.0-1.0  speech-probability bar. Silero default 0.7
VAD_START_SECS=0.15       # seconds of speech before it counts as speech
VAD_STOP_SECS=0.5         # seconds of silence before your turn is considered over
SARVAM_HIGH_VAD_SENSITIVITY=true

# --- Twilio (inbound phone calls) ---
# Public host Twilio can reach, NO scheme (we add wss:// ourselves).
# Local dev:  ngrok http 8080  ->  PUBLIC_HOSTNAME="abc123.ngrok-free.app"
PUBLIC_HOSTNAME=""
# Optional — only needed so the agent can hang up the call itself.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_LANGUAGE="en-IN"
TWILIO_SESSION_TIMEOUT_SECONDS=300
# Set false ONLY for local testing — disables both signature and token checks.
TWILIO_VALIDATE_SIGNATURE=true

# --- Outbound calling (the agent phones someone) ---
# Your Twilio voice-capable number, E.164. Required only for outbound.
TWILIO_FROM_NUMBER=""
# Detect voicemail and hang up instead of talking to an answering machine.
TWILIO_DETECT_VOICEMAIL=true
# Give up if nobody answers within this many seconds.
TWILIO_OUTBOUND_RING_TIMEOUT=30
